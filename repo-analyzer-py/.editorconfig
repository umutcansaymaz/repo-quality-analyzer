root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4
max_line_length = 100

[*.{py,pyi}]
indent_size = 4

[*.{yaml,yml}]
indent_size = 2

[*.{toml,ini,cfg}]
indent_size = 4

[*.md]
trim_trailing_whitespace = false
max_line_length = off

[Makefile]
indent_style = tab

[*.{json,js,ts,tsx,jsx}]
indent_size = 2
