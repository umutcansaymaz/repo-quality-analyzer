# Kalite Repo Analyzer — environment template.
# Copy this file to `.env` and adjust values for your local setup:
#   cp .env.example .env
#
# The SQLite database file is created automatically on first run.

# Database (SQLite via Prisma)
DATABASE_URL=file:./db/custom.db

# No other configuration is required. The analysis engine is fully local:
# the LLM API key (bring-your-own-key) is entered in the web UI and stored
# only in your browser's localStorage — never on the server.
